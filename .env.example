# NODE_ENV is deliberately NOT set here. It belongs at the process/platform
# level (the OS, the process manager, or the hosting platform set it — e.g.
# `NODE_ENV=production` in a real deployment), not in a dotenv file shared
# with the frontend build. apps/web's Vite build reads this same file via
# `envDir`, and a NODE_ENV value present in a loaded .env file leaks into
# esbuild's dependency pre-bundling and forces React into development mode
# — roughly doubling bundle size and shipping dev warnings in "production"
# output. Confirmed empirically: removing this line took the web build from
# 334.87KB back to 146.99KB. apps/api/src/config/env.ts already defaults
# NODE_ENV to "development" via its Zod schema when unset, so local dev is
# unaffected. See docs/DECISIONS.md ADR-006.

# ── MongoDB (docker-compose.yml) ────────────────────────
# Read directly by docker-compose.yml to initialize the container's root
# user, AND by MONGODB_URI below (which must match). Keep these in sync.
MONGO_ROOT_USERNAME=devflow_admin
MONGO_ROOT_PASSWORD=replace-with-a-strong-local-password
MONGO_DB_NAME=devflow

# ── API (apps/api) ──────────────────────────────────────
PORT=4000
MONGODB_URI=mongodb://devflow_admin:replace-with-a-strong-local-password@localhost:27017/devflow?authSource=admin
# How long to wait for a Mongo server before treating the connection as failed.
DB_CONNECT_TIMEOUT_MS=5000
# Must be >= 32 characters — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=1h
CORS_ORIGIN=http://localhost:5173
# Brute-force protection for /api/auth/register and /api/auth/login only —
# not a general API rate limit. See docs/DECISIONS.md ADR-007.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# AI provider (Ollama running locally)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
AI_REQUEST_TIMEOUT_MS=180000
# Context window (tokens) DevFlow requests from Ollama per call. Must be
# supported by the model; larger values use more GPU memory.
OLLAMA_NUM_CTX=16384

# Read-only local project scanner (Batch C1). See
# apps/api/src/services/scanner.service.ts and docs/DECISIONS.md.
SCAN_MAX_FILE_SIZE_BYTES=2000000
SCAN_MAX_FILES=2000
SCAN_MAX_DEPTH=12
SCAN_MAX_DIRECTORIES=2000
SCAN_MAX_DURATION_MS=30000

# ── Launcher (npm run dev, packages/launcher) ─────────
# All optional; the defaults are shown. The launcher also uses OLLAMA_BASE_URL,
# OLLAMA_MODEL and PORT above. It stops only what it started itself, never
# deletes MongoDB data, and never closes Docker Desktop. See docs/LAUNCHER.md.
# DEVFLOW_AUTOSTART_DEPENDENCIES=true   # false: do not manage Docker/MongoDB/Ollama
# DEVFLOW_COMPOSE_FILE=docker-compose.yml
# DEVFLOW_COMPOSE_PROJECT=devflow       # default: repo folder name, as Compose derives it
# DEVFLOW_MONGO_SERVICE=mongo
# DEVFLOW_STOP_OWNED_MONGO=true
# DEVFLOW_STOP_OWNED_OLLAMA=true
# DEVFLOW_DOCKER_DESKTOP_PATH=          # default: standard install locations
# DEVFLOW_OLLAMA_PATH=                  # default: PATH, then standard install location
# DEVFLOW_WEB_PORT=5173                 # must match apps/web/vite.config.ts
# DEVFLOW_STARTUP_TIMEOUT_MS=180000
# DEVFLOW_POLL_INTERVAL_MS=2000
# DEVFLOW_STOP_GRACE_MS=10000

# ── Web (apps/web) ──────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000/api
